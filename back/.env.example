# Variables del backend Django y de docker compose (MySQL).
# Nota: el .env que se carga es el de la RAIZ del proyecto (raiz/.env);
# este archivo sirve de plantilla para copiarlo ahi.
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=votacion
DB_USER=votacion_user
# Al definir DB_PASSWORD el backend usa MySQL; si queda vacia usa SQLite.
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Solo para el contenedor de Docker (usuario root).
DB_ROOT_PASSWORD=
