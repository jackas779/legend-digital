# Variables del backend Django (las lee settings.py) y de docker compose
# (las lee docker-compose.yml). Una sola fuente de verdad en la raíz.

DJANGO_SECRET_KEY=dev-secret-key-change-me-2026-votacion-project-!secure!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ----- MySQL (Docker) -----
# Al definir DB_PASSWORD el backend usa MySQL; si la dejas vacía sigue en
# SQLite para no romper el desarrollo local.
DB_NAME=votacion
DB_USER=votacion_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Clave del usuario root solo para el contenedor de Docker.
DB_ROOT_PASSWORD=
